{# @todo translation + add dynamic ps version #}
{% set version_type = 'major' %}
{% set version_type_label = 'Major' %}
{% set version = '9.0.0' %}
{% set contact_expert_url = 'https://experts.prestashop.com/english/experts/' %}

<div id="ua-dialog" class="bootstrap">
  <dialog class="dialog-notification" id="dialog-update-notification" aria-label="{{ 'Update notification' }}">
    <div class="dialog-notification__content">
      <div class="dialog-notification__left">
        <span class="dialog-notification__badge">
          {{ 'New available ' ~ version_type_label }}
        </span>

        <span class="dialog-notification__title">
          {{ 'New features are available' }}
        </span>
      </div>

      <div class="dialog-notification__right">
        <div class="dialog-notification__informations">
          <div class="dialog-notification__section">
            <span class="dialog-notification__section-title">
              {{ 'Description'}}
            </span>

            <p class="dialog-notification__section-content">
              {{ 'Patches are fixes made between major and minor versions. They introduce security and bug fixes.' }}
              <a class="dialog-notification__link" href="#" target="_blank">{{ 'See the update' }}</a>
            </p>
          </div>

          <div class="dialog-notification__section">
            <span class="dialog-notification__section-title">
              {{ 'Version' }}
            </span>

            <p class="dialog-notification__section-content">
              {{ version }}
            </p>
          </div>

          <div class="dialog-notification__section">
            <span class="dialog-notification__section-title">
              {{ 'Type of improvements' }}
            </span>

            <p class="dialog-notification__section-content">
              {% if version_type == 'patch' %}
                {{ 'Bugs, security patches' }}
              {% elseif version_type == 'minor' %}
                {{ 'Bugs, security patches, new features' }}
              {% elseif version_type == 'major' %}
                {{ 'New features, Improvements to existing features, Security and bug fixes' }}
              {% endif %}
            </p>
          </div>

          <div class="dialog-notification__section">
            <span class="dialog-notification__section-title">
              {{ 'Need help?' }}
            </span>

            <p class="dialog-notification__section-content">
              {{ 'If you\'re having trouble performing the update, our experts can help!'}}
              <a class="dialog-notification__link" href="{{ contact_expert_url }}" target="_blank">{{ 'Contact an expert' }}</a>
            </p>
          </div>
        </div>

        <div class="dialog-notification__buttons">
          <a class="dialog-notification__button btn btn-default" href="#" data-dismiss="dialog">
            {{ 'Later' }}
          </a>

          <a class="dialog-notification__button btn btn-primary" href="#">
            {{ 'Update' }}
          </a>
        </div>
      </div>
    </div>
  </dialog>
</div>