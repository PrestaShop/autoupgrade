includes:
	- %currentWorkingDirectory%/tests/phpstan/phpstan.neon

parameters:
	# PrestaShop 9 runs on PHP 8.1 and above, while our composer.json pins the platform to PHP 7.1.
	# Without this, PHPStan reads the core sources with a PHP 7.1 grammar and silently drops the
	# classes using a more recent syntax (AppKernel and its Symfony parents, for instance).
	phpVersion:
		min: 80100
		max: 80400

	excludePaths:
		- ./../../classes/UpgradeTools/CoreUpgrader/CoreUpgrader17.php
		- ./../../classes/Twig/TransFilterExtension.php
		- ./../../classes/UpgradeContainer.php
		# TODO: remove this once PrestaShop 9.2 is out
		- ./../../classes/UpgradeTools/CoreUpgrader/CoreServiceStub/Stubs
	ignoreErrors:
		- "#^Parameter \\#1 \\$callback of function array_map expects \\(callable\\(int\\)\\: mixed\\)\\|null, 'add_quotes' given\\.$#"
		-
			identifier: booleanAnd.rightAlwaysTrue
			path: ./../../classes/UpgradeSelfCheck.php
			count: 2
		-
			# Some PrestaShop may not have the method PrestaShopAutoload::generateIndex
			identifier: function.impossibleType
			path: ./../../classes/UpgradeTools/CoreUpgrader/CoreUpgrader.php
			count: 1
		-
			# Abstract class check on AppKernel is not detected by PHPStan, hence the false positive
			identifier: new.abstract
			path: ./../../classes/UpgradeTools/SymfonyAdapter.php
			count: 1
