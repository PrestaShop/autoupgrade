includes:
	- %currentWorkingDirectory%/tests/vendor/prestashop/php-dev-tools/phpstan/ps-module-extension.neon

parameters:
	bootstrapFiles:
		- ./forceAutoload.php
	paths:
		# From PHPStan 0.12, paths to check are relative to the neon file
		- ./../../classes
		- ./../../upgrade/php/deactivate_custom_modules.php
		- ./../../controllers
		- ./../../ajax-upgradetab.php
		- ./../../ajax-upgradetabconfig.php
		- ./../../autoupgrade.php
	ignoreErrors:
		-
			# Ignoring this error is necessary, see https://github.com/phpstan/phpstan/issues/13353
			identifier: variable.undefined
			path: ./../../classes/UpgradeTools/Translation.php
		-
			# PHPStan is mixing slash and antislash in its tests
			identifier: requireOnce.fileNotFound

	level: 6
